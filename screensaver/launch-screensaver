#!/usr/bin/env bash
set -euo pipefail

runtime="${EXPANSE_SCREENSAVER_ROOT:-$HOME/.local/share/omarchy-expanse}"
mode="${1:-}"
case "$mode" in
  ""|force|--preview) ;;
  *) echo "Usage: $0 [--preview|force]" >&2; exit 2 ;;
esac

theme_name=""
[[ ! -f $HOME/.local/state/omarchy/current/theme.name ]] || read -r theme_name < "$HOME/.local/state/omarchy/current/theme.name"
if [[ $theme_name != expanse && $mode != --preview ]]; then
  exec omarchy-launch-screensaver "$@"
fi

# Preserve Omarchy's screensaver-off preference and never cover a live locker.
if [[ $mode != force && $mode != --preview ]] && omarchy-toggle-enabled screensaver-off; then
  exit 0
fi
lock_state=$(omarchy-shell lock isLocked 2>/dev/null) || exit 1
[[ $lock_state == false ]] || exit 0

for asset in shell.qml pixel-dissolve.frag.qsb images/rocinante.png images/tycho.png images/nauvoo.png images/ring.png images/ceres.jpg images/eros.jpg images/ganymede.jpg images/io.jpg; do
  if [[ ! -r $runtime/org.omarchy.screensaver/$asset ]]; then
    echo "Missing Expanse screensaver asset: $asset; using the stock screensaver." >&2
    if [[ $mode == --preview ]]; then exec omarchy-launch-screensaver force; fi
    exec omarchy-launch-screensaver "$@"
  fi
done

exec 9>"${XDG_RUNTIME_DIR:-/tmp}/expanse-screensaver-${UID}.lock"
flock -n 9 || exit 0
# Skip if a screensaver window (this one or the stock one) is already open.
# Checking windows rather than command lines avoids false matches from any
# process that merely mentions the app ID.
if hyprctl clients -j 2>/dev/null | jq -e 'any(.[]; .class == "org.omarchy.screensaver")' >/dev/null; then
  exit 0
fi

# App ID is also in the config path so omarchy-system-lock's existing cleanup
# recognizes this process. No alternate lock timer or authentication is used.
export QS_APP_ID=org.omarchy.screensaver
qs -n -p "$runtime/org.omarchy.screensaver" &
saver=$!

# Omarchy's window rules park every screensaver window on a hidden special
# workspace and leave showing it to the launcher. Put each window on its own
# monitor's screensaver workspace, or on a special workspace that monitor is
# already showing (like the scratchpad), so that one is still open afterwards.
saver_windows() {
  hyprctl clients -j 2>/dev/null |
    jq -r '.[] | select(.mapped and .class == "org.omarchy.screensaver") | "\(.address) \(.monitor) \(.workspace.name)"'
}
focused=$(hyprctl monitors -j | jq -r '.[] | select(.focused) | .name')
monitor_count=$(hyprctl monitors -j | jq 'length')
declare -A placed=()
deadline=$((SECONDS + 5))
while (( ${#placed[@]} < monitor_count && SECONDS < deadline )) && kill -0 "$saver" 2>/dev/null; do
  while read -r address monitor workspace; do
    [[ -n $address && -z ${placed[$address]:-} ]] || continue
    read -r name special < <(hyprctl monitors -j | jq -r --argjson id "$monitor" '.[] | select(.id == $id) | "\(.name) \(.specialWorkspace.name)"')
    target=${special:-special:screensaver-$name}
    if [[ $workspace == "$target" ]] ||
      hyprctl dispatch "hl.dsp.window.move({ workspace = \"$target\", window = \"address:$address\" })" >/dev/null 2>&1 ||
      hyprctl dispatch movetoworkspace "$target,address:$address" >/dev/null 2>&1; then
      placed[$address]=1
    fi
  done < <(saver_windows)
  (( ${#placed[@]} >= monitor_count )) || sleep 0.1
done
if (( monitor_count > 1 )) && [[ -n $focused ]]; then
  hyprctl dispatch "hl.dsp.focus({ monitor = \"$focused\" })" >/dev/null 2>&1 || hyprctl dispatch focusmonitor "$focused" >/dev/null 2>&1 || true
fi

wait "$saver"
