{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "~/.config/omarchy/branding/about.txt",
    "color": {
      "1": "38;2;219;124;62",
      "2": "38;2;192;137;51"
    },
    "padding": {
      "top": 2,
      "right": 4,
      "left": 2
    }
  },
  "display": {
    "disableLinewrap": true,
    "key": {
      "width": 23
    },
    "color": {
      "output": "38;2;241;221;213",
      "separator": "38;2;104;97;99"
    },
    "bar": {
      "width": 8,
      "color": {
        "elapsed": "38;2;219;124;62",
        "total": "38;2;104;97;99",
        "border": "38;2;104;97;99"
      },
      "char": {
        "elapsed": "▰",
        "total": "▱"
      },
      "border": {
        "left": "",
        "right": ""
      }
    },
    "percent": {
      "type": [
        "num",
        "bar",
        "bar-monochrome"
      ],
      "color": {
        "green": "38;2;219;124;62",
        "yellow": "38;2;192;137;51",
        "red": "38;2;214;112;102"
      }
    },
    "pipe": false
  },
  "modules": [
    {
      "type": "custom",
      "format": "\u001b[1;38;2;219;124;62mROCINANTE // SYSTEM DIAGNOSTICS\u001b[0m"
    },
    {
      "type": "custom",
      "format": "\u001b[38;2;192;137;51mCORVETTE-CLASS · OPERATIONS TERMINAL\u001b[0m"
    },
    {
      "type": "custom",
      "format": "\u001b[38;2;104;97;99m┌─ \u001b[0m\u001b[38;2;219;124;62mSHIP SYSTEMS\u001b[0m\u001b[38;2;104;97;99m ─────────────────────────────────────────\u001b[0m"
    },
    {
      "type": "host",
      "key": "│ Hull",
      "keyColor": "38;2;219;124;62",
      "format": "{name}"
    },
    {
      "type": "cpu",
      "key": "│ Processing core",
      "keyColor": "38;2;219;124;62",
      "format": "{name}"
    },
    {
      "type": "gpu",
      "key": "│ Render array",
      "keyColor": "38;2;219;124;62",
      "detectionMethod": "pci",
      "format": "{name}"
    },
    {
      "type": "display",
      "key": "│ Visual interface",
      "keyColor": "38;2;219;124;62",
      "format": "{width} × {height}{?refresh-rate} @ {refresh-rate} Hz{?}"
    },
    {
      "type": "disk",
      "key": "│ Data banks",
      "keyColor": "38;2;219;124;62",
      "folders": "/",
      "format": "{size-percentage-bar} {size-percentage} · {size-used} / {size-total}"
    },
    {
      "type": "memory",
      "key": "│ Working memory",
      "keyColor": "38;2;219;124;62",
      "format": "{percentage-bar} {percentage} · {used} / {total}"
    },
    {
      "type": "swap",
      "key": "│ Reserve memory",
      "keyColor": "38;2;219;124;62",
      "format": "{used} / {total}"
    },
    {
      "type": "custom",
      "format": "\u001b[38;2;104;97;99m└────────────────────────────────────────────────────────\u001b[0m"
    },
    {
      "type": "custom",
      "format": "\u001b[38;2;104;97;99m┌─ \u001b[0m\u001b[38;2;219;124;62mFLIGHT SOFTWARE\u001b[0m\u001b[38;2;104;97;99m ──────────────────────────────────────\u001b[0m"
    },
    {
      "type": "command",
      "key": "│ Operating system",
      "keyColor": "38;2;219;124;62",
      "text": "version=$(omarchy-version) && printf \"Omarchy %s\\n\" \"$version\""
    },
    {
      "type": "kernel",
      "key": "│ Core",
      "keyColor": "38;2;219;124;62"
    },
    {
      "type": "wm",
      "key": "│ Display control",
      "keyColor": "38;2;219;124;62"
    },
    {
      "type": "terminal",
      "key": "│ Command console",
      "keyColor": "38;2;219;124;62"
    },
    {
      "type": "packages",
      "key": "│ Software manifest",
      "keyColor": "38;2;219;124;62"
    },
    {
      "type": "command",
      "key": "│ Update channel",
      "keyColor": "38;2;219;124;62",
      "text": "omarchy-version-channel"
    },
    {
      "type": "command",
      "key": "│ Livery",
      "keyColor": "38;2;219;124;62",
      "text": "omarchy-theme-current"
    },
    {
      "type": "terminalfont",
      "key": "│ Interface font",
      "keyColor": "38;2;219;124;62"
    },
    {
      "type": "custom",
      "format": "\u001b[38;2;104;97;99m└────────────────────────────────────────────────────────\u001b[0m"
    },
    {
      "type": "custom",
      "format": "\u001b[38;2;104;97;99m┌─ \u001b[0m\u001b[38;2;192;137;51mSERVICE LOG\u001b[0m\u001b[38;2;104;97;99m ──────────────────────────────────────────\u001b[0m"
    },
    {
      "type": "command",
      "key": "│ Time in service",
      "keyColor": "38;2;192;137;51",
      "text": "born=$(stat -c %W /); if [ \"$born\" -gt 0 ] 2>/dev/null; then echo \"$(( ($(date +%s) - born) / 86400 )) days\"; else echo \"Unknown\"; fi"
    },
    {
      "type": "uptime",
      "key": "│ Current watch",
      "keyColor": "38;2;192;137;51"
    },
    {
      "type": "command",
      "key": "│ Last maintenance",
      "keyColor": "38;2;192;137;51",
      "text": "omarchy-version-pkgs"
    },
    {
      "type": "custom",
      "format": "\u001b[38;2;104;97;99m└────────────────────────────────────────────────────────\u001b[0m"
    }
  ]
}
